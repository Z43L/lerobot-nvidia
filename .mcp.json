{
  "mcpServers": {
    "so101-hub": {
      "command": "./.venv312/bin/python",
      "args": [
        "hub/so101_hub.py"
      ],
      "env": {
        "SO101_VLA_DEVICE": "mps"
      }
    },
    "so101-motion": {
      "command": "./.venv312/bin/python",
      "args": [
        "hub/so101_motion.py"
      ],
      "env": {
        "SO101_MAX_RELATIVE_TARGET": "2",
        "SO101_VLA_DEVICE": "mps"
      }
    },
    "so101-sim": {
      "command": "./.venv312/bin/python",
      "args": [
        "sim/mcp_server.py"
      ],
      "env": {
        "SO101_BACKEND": "sim",
        "SO101_VLA_DEVICE": "mps"
      }
    },
    "so101-sim-hanoi": {
      "command": "./.venv312/bin/python",
      "args": [
        "sim/mcp_server.py"
      ],
      "env": {
        "SO101_BACKEND": "sim",
        "SO101_SCENE": "hanoi",
        "SO101_HANOI_VLA_RED": "",
        "SO101_HANOI_VLA_GREEN": "",
        "SO101_HANOI_VLA_BLUE": "",
        "SO101_HANOI_VLA_CYAN": "",
        "SO101_HANOI_VLA_BROWN": "",
        "SO101_VLA_DEVICE": "mps"
      }
    },
    "so101-sim-objects": {
      "command": "./.venv312/bin/mjpython",
      "args": [
        "sim/mcp_server.py"
      ],
      "env": {
        "SO101_BACKEND": "sim",
        "SO101_SCENE": "objects",
        "SO101_GRASP": "attach",
        "SO101_VIEWER": "1",
        "SO101_PUBLISH_STATE": "1",
        "SO101_VLA_DEVICE": "mps"
      }
    },
    "so101-real": {
      "command": "./.venv312/bin/python",
      "args": [
        "sim/mcp_server.py"
      ],
      "env": {
        "SO101_BACKEND": "real",
        "SO101_MAX_RELATIVE_TARGET": "2",
        "SO101_VLA_DEVICE": "mps",
        "SO101_FOLLOWER_PORT": "/dev/cu.usbmodem5B910311921",
        "SO101_LEADER_PORT": "/dev/cu.usbmodem5AB01585131",
        "SO101_FOLLOWER_ID": "so101_follower",
        "SO101_LEADER_ID": "so101_leader",
        "SO101_TOP_CAM": "0",
        "SO101_WRIST_CAM": "1",
        "SO101_TABLE_CAM": "-1",
        "ALLOW_REAL_MOTION": "1"
      }
    },
    "so101-real-hanoi": {
      "command": "./.venv312/bin/python",
      "args": [
        "sim/mcp_server.py"
      ],
      "env": {
        "SO101_BACKEND": "real",
        "SO101_SCENE": "hanoi",
        "SO101_MAX_RELATIVE_TARGET": "2",
        "SO101_HANOI_VLA_RED": "",
        "SO101_HANOI_VLA_GREEN": "",
        "SO101_HANOI_VLA_BLUE": "",
        "SO101_HANOI_VLA_CYAN": "",
        "SO101_HANOI_VLA_BROWN": "",
        "SO101_VLA_DEVICE": "mps",
        "SO101_FOLLOWER_PORT": "/dev/cu.usbmodem5B910311921",
        "SO101_LEADER_PORT": "/dev/cu.usbmodem5AB01585131",
        "SO101_FOLLOWER_ID": "so101_follower",
        "SO101_LEADER_ID": "so101_leader",
        "SO101_TOP_CAM": "0",
        "SO101_WRIST_CAM": "1",
        "SO101_TABLE_CAM": "-1",
        "ALLOW_REAL_MOTION": "1"
      }
    }
  }
}
