<mujoco model="so101_pick_scene">
    <!-- Escena de prueba: SO-101 + mesa + cubo + cámara fija. Solo para validar el MCP antes del hardware real. -->
    <include file="so101_new_calib.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global offwidth="640" offheight="480" />
    </visual>

    <worldbody>
        <light pos="0 0 2" dir="0 0 -1" directional="true" />
        <geom name="floor" size="1 1 0.05" pos="0 0 0" type="plane" rgba="0.85 0.85 0.85 1" />

        <!-- Cámara cenital/frontal fija, mirando a la zona de trabajo del brazo -->
        <camera name="front" pos="0.35 -0.45 0.35" xyaxes="0.8 0.6 0 -0.2 0.3 0.93" fovy="55" />

        <!-- Objeto a manipular -->
        <body name="cube" pos="0.2 0.0 0.02">
            <freejoint name="cube_free" />
            <geom name="cube_geom" type="box" size="0.02 0.02 0.02" rgba="0.9 0.2 0.2 1" mass="0.03" />
        </body>
    </worldbody>
</mujoco>
